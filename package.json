{
    "name": "hamadeh-io",
    "version": "3.14.1",
    "private": true,
    "type": "module",
    "scripts": {
        "preinstall": "bun scripts/ensure-bun.ts",
        "dev": "sh scripts/check-toolchain.sh && bun scripts/generate-static-assets.ts && bun --bun vite dev",
        "build": "sh scripts/check-toolchain.sh && bun scripts/generate-static-assets.ts && bun --bun vite build",
        "start": "sh scripts/check-toolchain.sh && bun scripts/serve-static.ts",
        "generate:assets": "bun scripts/generate-static-assets.ts",
        "check": "oxlint .",
        "check:fix": "oxlint --fix . && oxfmt --write .",
        "check:staged": "bun scripts/check-staged.ts",
        "check:toolchain": "sh scripts/check-toolchain.sh",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "type-check": "bun ./node_modules/typescript/bin/tsc --noEmit",
        "type-check:tests": "bun ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.tests.json",
        "test": "bun test",
        "test:coverage": "bun test --coverage",
        "test:e2e": "bunx playwright test",
        "test:e2e:ui": "bunx playwright test --ui",
        "test:e2e:headed": "bunx playwright test --headed",
        "test:e2e:install": "bunx playwright install chromium",
        "content:check": "bun scripts/check-content.ts",
        "clean": "bun scripts/clean.ts",
        "healthcheck": "sh scripts/check-toolchain.sh && bun run format:check && bun run type-check && bun run type-check:tests && bun run check && bun run content:check && bun run test",
        "new:problem": "bun scripts/new-problem.ts",
        "publish:problem": "bun scripts/publish-problem.ts",
        "prepare": "husky"
    },
    "dependencies": {
        "@11ty/gray-matter": "^3.0.0",
        "@fontsource-variable/fira-code": "^5.3.0",
        "@fontsource-variable/lexend": "^5.3.0",
        "@fontsource-variable/quicksand": "^5.3.0",
        "@fontsource/baloo-2": "^5.3.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-tabs": "^1.2.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-start": "^1.169.7",
        "clsx": "^2.1.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-icons": "^5.7.0",
        "tailwind-merge": "^3.7.0",
        "valibot": "^1.5.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@resvg/resvg-js": "^2.6.2",
        "@shikijs/rehype": "^4.6.0",
        "@tailwindcss/vite": "^4.3.5",
        "@types/bun": "^1.4.4",
        "@types/hast": "^3.0.5",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "husky": "^9.1.7",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "rehype-stringify": "^10.0.1",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "satori": "^0.63.2",
        "shiki": "^4.6.0",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.2.0",
        "vite": "^8.4.0"
    },
    "overrides": {
        "fflate": "^0.7.5",
        "postcss-selector-parser": "^7.1.6"
    },
    "engines": {
        "bun": ">=1.4.2 <2.0.0"
    },
    "packageManager": "bun@1.4.2"
}
