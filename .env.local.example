# hamadeh.io — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# Use the same vars in Vercel Project Settings → Environment Variables for deployment.
#
# Local:   Copy to .env.local
# Deploy:  Add matching vars in Vercel (VITE_* for client)

# ─────────────────────────────────────────────────────────────────────────────
# Site & Branding (used for metadata, canonical URLs, etc.)
# ─────────────────────────────────────────────────────────────────────────────
VITE_SITE_URL=https://hamadeh.io
VITE_SITE_NAME=hamadeh.io
VITE_AUTHOR_NAME=Masom Hamadeh
VITE_AUTHOR_EMAIL=masom@hamadeh.io

# ─────────────────────────────────────────────────────────────────────────────
# Footer / Git badge (optional)
# Usually inferred at build time from git/CI. Only set these if you want manual overrides.
# ─────────────────────────────────────────────────────────────────────────────
# VITE_GIT_BRANCH=main
# VITE_GIT_SHA=abc1234

# ─────────────────────────────────────────────────────────────────────────────
# Optional backend (Phase 2 — if needed later)
# Keep backend secrets server-only and do not prefix them with VITE_.
# ─────────────────────────────────────────────────────────────────────────────
# Example:
# BACKEND_API_URL=https://api.example.com
# BACKEND_API_KEY=your-server-only-secret
